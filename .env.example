# Copy this file to .env and fill in what you have.
# The app runs on yfinance alone with no keys at all — everything
# below is optional and only unlocks extra data sources / features.

# --- Optional market/fundamentals data ---
ALPHA_VANTAGE_API_KEY=

# --- Optional news sources (Phase 2) ---
NEWS_API_KEY=

# --- Optional AI Assistant chat (Phase 5) ---
# Get a key at https://console.anthropic.com — without this set, the
# rest of the app works completely normally, the AI Assistant page
# just shows a clear message instead of a chat interface.
ANTHROPIC_API_KEY=

# --- App behavior ---
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./data/stock_ai.db

# How often the background scheduler polls the watchlist during
# market hours, in seconds. 300 = 5 minutes.
POLL_INTERVAL_SECONDS=300

# --- Notifications (future phases) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
